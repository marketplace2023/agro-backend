{
  "name": "agro-backend",
  "type": "module",
  "imports": {
    "#*": "./src/*.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:roles": "tsx src/database/seeds/roles.ts",
    "db:seed:menus": "tsx src/database/seeds/backoffice-menus.ts",
    "db:seed:categories": "tsx src/database/seeds/categories.ts",
    "db:seed:units": "tsx src/database/seeds/units.ts",
    "db:seed:locations": "tsx src/database/seeds/locations.ts",
    "db:seed:settings": "tsx src/database/seeds/settings.ts",
    "db:seed": "npm run db:seed:roles && npm run db:seed:menus && npm run db:seed:categories && npm run db:seed:units && npm run db:seed:locations && npm run db:seed:settings"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "bcrypt": "^6.0.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.4",
    "nodemailer": "^8.0.10",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "resultable": "^0.3.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.17",
    "@types/nodemailer": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
