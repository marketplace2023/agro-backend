NODE_ENV=development
PORT=3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agro_db

# JWT Secrets (min 32 characters each)
JWT_SECRET=change_this_to_a_random_secret_of_at_least_32_chars
JWT_PASSWORD_RESET_SECRET=change_this_to_another_random_secret_32_chars

# Frontend
FRONTEND_URL=http://localhost:5173

# Mail (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_SECURE=
MAIL_USER=your_mailtrap_user
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@marketplaceagro.co
